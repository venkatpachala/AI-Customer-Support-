# Copy to the host environment. Do not commit filled-in secrets.

TOOLS_MODE=mock
PORT=8000
DATABASE_URL=sqlite:///./data/d2c_agent.db
# Postgres example (also accepts postgres:// and postgresql://):
# DATABASE_URL=postgresql+psycopg2://d2c:d2c@postgres:5432/d2c

# Brand owner login is ops@zepto.local with this password.
OPS_PASSWORD=
OPS_SESSION_SECRET=

# Optional. Leave unset for /health. Live Shopify and Stripe are not enabled.
# SHOPIFY_SHOP_DOMAIN=
# SHOPIFY_ACCESS_TOKEN=
# STRIPE_SECRET_KEY=
# OPENAI_API_KEY=
# PINECONE_API_KEY=

# Set to 1 behind HTTPS so the owner cookie is Secure.
# COOKIE_SECURE=1
