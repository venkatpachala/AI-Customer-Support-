# Copy to the host environment. Do not commit filled-in secrets.

TOOLS_MODE=mock
PORT=8000
DATABASE_URL=sqlite:///./data/d2c_agent.db
# Postgres example (also accepts postgres:// and postgresql://):
# DATABASE_URL=postgresql+psycopg2://d2c:d2c@postgres:5432/d2c

# Brand owner login is ops@zepto.local with this password.
OPS_PASSWORD=
OPS_SESSION_SECRET=

# Optional. Leave unset for /health. Brand tokens are saved per tenant, not here.
# A live secret on the host is used only when that tenant has no stored credential.
# SHOPIFY_SHOP_DOMAIN=
# SHOPIFY_ACCESS_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_MODE=test
# OPENAI_API_KEY=
# PINECONE_API_KEY=
# DAILY_REQUEST_CAP=2000
# ALERT_WEBHOOK_URL=

# Set to 1 behind HTTPS so the owner cookie is Secure.
# COOKIE_SECURE=1
