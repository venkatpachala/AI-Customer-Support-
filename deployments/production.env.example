# Copy to deployments/production.env. Never commit the populated file.
# Use URL-safe generated values for DB passwords in this compose template.
POSTGRES_PASSWORD=replace-with-generated-migration-password
D2C_APP_DB_PASSWORD=replace-with-generated-application-password
APP_ENV=production
PUBLIC_APP_URL=https://support.example.com
OPS_SESSION_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEYS=replace-with-a-generated-fernet-key
OPENAI_API_KEY=configure-in-secret-store
LLM_PROVIDER=openai
SUPERVISOR_MODEL=gpt-4o-mini
PLANNER_MODEL=gpt-4o-mini
QA_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
KNOWLEDGE_EMBEDDINGS=none
TOOLS_MODE=mock
SHOPIFY_API_VERSION=2026-07
METRICS_TOKEN=replace-with-a-separate-random-monitoring-secret
LIVE_REFUNDS_ENABLED=0
PAYMENT_INTEGRATION_VERIFIED=0
LANGCHAIN_TRACING_V2=false
COOKIE_SECURE=1
DAILY_REQUEST_CAP=2000
ALLOW_LEGACY_ACTOR_HEADERS=0
TRUSTED_PROXY_IPS=127.0.0.1
# Configure email for real order verification. The worker sends it over TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Comma-separated, administrator-approved public HTTPS webhook hosts only.
WEBHOOK_ALLOWED_HOSTS=
